# Copy this file to .env and fill in what you need. Every setting is optional.
# .env is never committed to Git and is blocked from the browser.

# Full live address, used for canonical links, share tags and the sitemap.
# Leave empty on your laptop.
SITE_URL=

# Only if the site runs in a subfolder and it is not detected automatically, e.g. /CRETECH_New/
SITE_BASE=

# Where enquiry emails go (defaults to the email in content/site-config.js)
MAIL_TO=
# Sender address for enquiry emails (defaults to website@<your domain>)
MAIL_FROM=

# Long random text used to sign form tokens and sessions.
# If empty, one is created automatically in storage/private/secret.key
APP_SECRET=
